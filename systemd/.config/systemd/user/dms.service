[Unit]
Description=Dank Material Shell (DMS)
PartOf=sway-session.target
BindsTo=sway-session.target
After=sway-session.target
# Each failed start takes ~1s plus RestartSec, so the default 5-in-10s limit
# never trips and DMS loops forever once the compositor is gone.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=dbus
BusName=org.freedesktop.Notifications
ExecStart=/usr/bin/dms run --session
ExecReload=/usr/bin/pkill -USR1 -x dms
Restart=on-failure
RestartSec=1.23
TimeoutStopSec=10

[Install]
WantedBy=sway-session.target
