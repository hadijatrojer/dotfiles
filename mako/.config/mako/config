anchor=top-right
default-timeout=5000
width=420
outer-margin=20
padding=10,15
border-size=2
max-icon-size=32
font=sans-serif 14px

# Catppuccin Latte colors
background-color=#eff1f5
text-color=#4c4f69
border-color=#ccd0da
progress-color=#1e66f5

[mode=do-not-disturb]
invisible=true

[mode=do-not-disturb app-name=notify-send]
invisible=false

[urgency=low]
background-color=#eff1f5
text-color=#1e66f5
border-color=#ccd0da

[urgency=normal]
background-color=#eff1f5
text-color=#4c4f69
border-color=#ccd0da

[urgency=critical]
background-color=#eff1f5
text-color=#d20f39
border-color=#d20f39
default-timeout=0
layer=overlay
