anchor=top-right
default-timeout=5000
width=420
outer-margin=20
padding=10,15
border-size=2
max-icon-size=32
font=sans-serif 14px

# Catppuccin Macchiato colors
background-color=#24273a
text-color=#cad3f5
border-color=#363a4f
progress-color=#8aadf4

[mode=do-not-disturb]
invisible=true

[mode=do-not-disturb app-name=notify-send]
invisible=false

[urgency=low]
background-color=#24273a
text-color=#8aadf4
border-color=#363a4f

[urgency=normal]
background-color=#24273a
text-color=#cad3f5
border-color=#363a4f

[urgency=critical]
background-color=#24273a
text-color=#ed8796
border-color=#ed8796
default-timeout=0
layer=overlay
