anchor=top-right
default-timeout=5000
width=420
outer-margin=20
padding=10,15
border-size=2
max-icon-size=32
font=sans-serif 14px

# Tokyo Night colors
background-color=#1a1b26
text-color=#c0caf5
border-color=#24283b
progress-color=#7aa2f7

[mode=do-not-disturb]
invisible=true

[mode=do-not-disturb app-name=notify-send]
invisible=false

[urgency=low]
background-color=#1a1b26
text-color=#7aa2f7
border-color=#24283b

[urgency=normal]
background-color=#1a1b26
text-color=#c0caf5
border-color=#24283b

[urgency=critical]
background-color=#1a1b26
text-color=#f7768e
border-color=#f7768e
default-timeout=0
layer=overlay
