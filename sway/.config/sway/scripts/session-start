#!/usr/bin/env bash
set -euo pipefail

remove_stale_chrome_lock() {
  local profile_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/google-chrome"
  local lock_path="${profile_dir}/SingletonLock"
  local lock_target lock_host lock_pid process_cmdline

  [[ -L "${lock_path}" ]] || return 0

  lock_target="$(readlink "${lock_path}")"
  lock_host="${lock_target%-*}"
  lock_pid="${lock_target##*-}"

  # A lock from another host may still be active on a shared home directory.
  [[ "${lock_host}" == "$(hostname)" ]] || return 0
  [[ "${lock_pid}" =~ ^[0-9]+$ ]] || return 0

  if [[ -r "/proc/${lock_pid}/cmdline" ]]; then
    process_cmdline="$(tr '\0' ' ' < "/proc/${lock_pid}/cmdline")"
    [[ "${process_cmdline}" == *chrome* ]] && return 0
  fi

  rm -f -- \
    "${profile_dir}/SingletonLock" \
    "${profile_dir}/SingletonCookie" \
    "${profile_dir}/SingletonSocket"
}

remove_stale_chrome_lock

session_env=(
  DISPLAY
  WAYLAND_DISPLAY
  XDG_CURRENT_DESKTOP
  XDG_SESSION_TYPE
  SWAYSOCK
)

systemctl --user import-environment "${session_env[@]}" || true

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd "${session_env[@]}" >/dev/null 2>&1 || true
fi

# Stop session services when the compositor exits, whichever way it exits
# (DMS logout, session-quit, crash). Both sway and swayward emit the i3 IPC
# shutdown event, and swaymsg also returns when the socket closes. Sway runs
# this script on every reload, so the lock keeps one watcher per compositor.
start_session_watch() {
  [[ -n "${SWAYSOCK:-}" ]] || return 0
  local lock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/session-watch.${SWAYSOCK##*/}.lock"

  # shellcheck disable=SC2016 # expanded by the inner shell
  setsid -f bash -c '
    exec 9>"$1"
    flock -n 9 || exit 0
    swaymsg -t subscribe "[\"shutdown\"]" >/dev/null 2>&1 || true
    systemctl --user stop sway-session.target
    systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY SWAYSOCK I3SOCK
    rm -f -- "$1"
  ' session-watch "${lock}" </dev/null >/dev/null 2>&1
}

# A previous session may have left DMS failed or rate-limited.
systemctl --user reset-failed dms.service 2>/dev/null || true
systemctl --user start sway-session.target
start_session_watch
